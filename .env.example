APP_NAME=Vendor Invoice Extraction
DATABASE_PATH=data/vendor_invoices.db
UPLOAD_DIR=data/uploads

# Configure an OpenAI or company OpenAI-compatible Chat Completions endpoint.
# The UI can start while unconfigured, but processing requires this provider.
LLM_PROVIDER=openai_compatible
LLM_MODEL=your-model-name
LLM_API_KEY=
LLM_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
LLM_EXTRA_HEADERS_JSON={}
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_AGENT_STEPS=8
LLM_TEMPERATURE=0
